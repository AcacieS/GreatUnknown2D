# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/GreatUnknown/.utmp/
/GreatUnknown/[Aa]ssets/_Recovery*
/GreatUnknown/Assets/AddressableAssetsData/*
/GreatUnknown/[Ll]ibrary/
/GreatUnknown/[Tt]emp/
/GreatUnknown/[Oo]bj/
/GreatUnknown/[Bb]uild/
/GreatUnknown/[Bb]uilds/
/GreatUnknown/[Ll]ogs/
/GreatUnknown/[Uu]ser[Ss]ettings/
/GreatUnknown/*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/GreatUnknown/[Mm]emoryCaptures/

# Recordings can get excessive in size
/GreatUnknown/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/GreatUnknown/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/GreatUnknown/.vs/

# Gradle cache directory
/GreatUnknown/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/GreatUnknown/ExportedObj/
/GreatUnknown/.consulo/
/GreatUnknown/*.csproj
/GreatUnknown/*.unityproj
/GreatUnknown/*.sln
/GreatUnknown/*.suo
/GreatUnknown/*.tmp
/GreatUnknown/*.user
/GreatUnknown/*.userprefs
/GreatUnknown/*.pidb
/GreatUnknown/*.booproj
/GreatUnknown/*.svd
/GreatUnknown/*.pdb
/GreatUnknown/*.mdb
/GreatUnknown/*.opendb
/GreatUnknown/*.VC.db

# Unity3D generated meta files
/GreatUnknown/*.pidb.meta
/GreatUnknown/*.pdb.meta
/GreatUnknown/*.mdb.meta

# Unity3D generated file on crash reports
/GreatUnknown/sysinfo.txt

# Builds
/GreatUnknown/*.apk
/GreatUnknown/*.aab
/GreatUnknown/*.unitypackage
/GreatUnknown/*.unitypackage.meta
/GreatUnknown/*.app

# Crashlytics generated file
/GreatUnknown/crashlytics-build.properties

# Packed Addressables
/GreatUnknown/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/GreatUnknown/[Aa]ssets/[Ss]treamingAssets/aa.meta
/GreatUnknown/[Aa]ssets/[Ss]treamingAssets/aa/*

# Mac OS
**/.DS_Store
