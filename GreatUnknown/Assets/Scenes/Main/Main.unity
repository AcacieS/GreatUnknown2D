  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201CTHE SEA TWISTS OUR FLESH.\r\nA THOUSAND EYES, \r\nAND YET\r\nNOT
    ONE SCREAM\u201D\r\n\n\r\nThe final transmission from a stray fishing vessel
    near the heart of\nthe anomaly shortly after its discovery\r\n\r\nThe waters
    nearby muffle all but the strongest transmissions, making\nunmanned probes an
    impossibility. The Shorelife Oceanographic Institute has volunteered to research
    this phenomenon. You are the first manned\nmission to the center of the anomaly.\r\n\r\nPress
    any key to continue\u2026\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bda6caafe1d3bea4b8ab9aa8b075d3d0, type: 2}
