  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201Cthe sea twists our flesh. A thousand eyes, and yet not one scream\u201D\r\nThe
    final transmission from a stray fishing vessel near the heart of the anomaly
    shortly after its discovery\r\n\r\nThe waters nearby muffle all but the strongest
    transmissions, making unmanned probes an impossibility. The Shorelife Oceanographic
    Institute has volunteered to research this phenomenon. You are the first manned
    mission to the center of the anomaly.\r\n\r\nPress any key to continue\u2026\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9701473db3ca4e640948a801c8368a1e, type: 2}
